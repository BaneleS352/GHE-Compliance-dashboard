# Root Docker Compose configuration for a real Entra deployment.
# Copy to .env and replace every placeholder before building.

# PostgreSQL service credentials. URL-encode reserved characters in passwords.
POSTGRES_DB=ghe_compliance
POSTGRES_USER=ghe_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://ghe_user:replace-with-a-strong-password@db:5432/ghe_compliance?schema=public

# API access-token validation. OIDC_CLIENT_ID is not used by the API; audience,
# authorized SPA client IDs, and the delegated scope are checked independently.
OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# For the expected Entra v2 access token, use the API app's client ID GUID,
# matching the token's `aud` claim (not the full requested scope URI).
OIDC_AUDIENCE=<api-application-client-id>
# Comma-separated SPA app IDs allowed in the token's `azp` claim.
OIDC_ALLOWED_CLIENT_IDS=<spa-application-client-id>
# Delegated permission required in the token's `scp` claim.
OIDC_REQUIRED_SCOPE=access_as_user
# Usually matches OIDC_AUTHORITY.
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Frontend MSAL public-client settings, baked into the frontend image at build time.
# Authorization Code + PKCE needs no client secret in the browser.
VITE_ENTRA_CLIENT_ID=<spa-application-client-id>
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_API_SCOPE=api://<api-application-client-id>/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:3000

# Local Compose defaults. Override CORS_ORIGIN and the redirect URI for deploys.
CORS_ORIGIN=http://localhost:3000

# Set true only when the database is empty and should receive demo/bootstrap data.
SEED_ON_BOOT=false

# Optional notification delivery endpoint. Keep secrets in a deployment secret store.
# EMAIL_WEBHOOK_URL=

# Optional build-time corporate proxy root CA for Docker's Python package install.
# Encode a trusted PEM root certificate as one base64 line; leave blank otherwise.
# PIP_CA_CERT_BASE64=
