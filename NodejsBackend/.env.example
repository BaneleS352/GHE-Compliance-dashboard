# PostgreSQL (the only supported provider — local install or any server):
DATABASE_URL="postgresql://postgres:root@localhost:5432/ghe_compliance?schema=public"

OIDC_AUTHORITY="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Must match the access token `aud` claim. With the v2 tokens expected here,
# this is the API registration's Application (client) ID GUID.
OIDC_AUDIENCE="<api-application-client-id>"
# Comma-separated SPA application client IDs expected in the access token's `azp` claim.
OIDC_ALLOWED_CLIENT_IDS="<spa-application-client-id>"
# Delegated API permission name expected in the access token's `scp` claim.
OIDC_REQUIRED_SCOPE="access_as_user"
# Usually the same value as OIDC_AUTHORITY. Override only for a non-standard issuer.
OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# The SPA is a public client using Authorization Code + PKCE; do not add a client secret here.
CORS_ORIGIN="http://localhost:5173"
PORT=3001

# On-demand HIS profile lookup (never commit a real token).
STAFF_API_ENDPOINT="https://his-api-uat.betsolutions.net/api/Staff/SearchEmployees"
STAFF_API_ALLOWED_HOSTS="his-api-uat.betsolutions.net"
AUTH_TOKEN=""
# Defaults are Authorization: Bearer <AUTH_TOKEN>; override only if HIS specifies another contract.
AUTH_TOKEN_HEADER="Authorization"
AUTH_TOKEN_SCHEME="Bearer"
# Set true only for Microsoft-backed app sessions; dev.bat's local test
# identity provider does not call HIS. Branch mapping is mandatory and must
# match local Organization.shortCode values exactly.
STAFF_PROFILE_SYNC_ENABLED="false"
STAFF_BRANCH_ORG_MAP='{"BET":"BET"}'
