generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev/tests. Production Docker build rewrites this to
  // "postgresql" (see Dockerfile sed step) and runs versioned migrations
  // via `prisma migrate deploy` (see entrypoint.sh and prisma/migrations/).
  //
  // Phase 5 cutover complete (see docs/DATABASE-NORMALIZATION-GOAL.md
  // "Full Normalized-Codebase Migration Plan" + prisma/RETIREMENT.md):
  // the schema below is the normalized model. Legacy compatibility columns
  // (Declaration employee-context/detail text, files JSON, approver text,
  // WorkflowRule/WorkflowInstance steps JSON, UploadedFile.declarationId)
  // and compatibility tables (Dropdowns, ComplianceTrendPoint,
  // TypeBreakdownItem, AppRole, UserRole, OrganizationSetting, Ref* lookup
  // copies) were removed in migration 0005_phase5_retirement after the
  // backfill/verify gates passed. The API response shape is unchanged —
  // `declarationResponse` in services/workflowService.ts builds the
  // user-facing fields from Snapshot/Detail/Counterparty/User joins.
  //
  // Ownership decisions (Phase A):
  //   - SystemConfig is the authoritative config source; OrganizationSetting removed.
  //   - User.role is the authoritative authorization source; AppRole/UserRole removed.
  //   - Declaration type/status/priority remain validated strings (zod +
  //     valid-status lists); the unenforced Ref* copies were removed until a
  //     domain-specific reference design with FKs is approved.
  //   - Counterparty identity: unique (organizationId, name) for scoped rows
  //     (partial unique index on PostgreSQL, see 0003); global rows
  //     (organizationId NULL) are intentionally exempt master data.
  //   - DeclarationFile is the only file association; UploadedFile rows must
  //     have a join row (orphans are rejected).
  //   - WorkflowInstanceStep / WorkflowRuleStep rows are the only workflow
  //     state/definition; no JSON fallback exists.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  shortCode String   @unique
  users     User[]
  declarations Declaration[] @relation("DeclarationOrganization")
  departments Department[]
  counterparties Counterparty[]
  workflowRules WorkflowRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  passwordHash     String
  role             String
  teamMemberNumber String
  department       String
  position         String
  lineManager      String?
  organizationId   String?

  managerId    String?
  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[] @relation("UserManager")

  departmentId String?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  declarationsOwned Declaration[] @relation("DeclarationDeclarer")
  approvalsAssigned Declaration[] @relation("DeclarationApprover")
  stepsAssigned WorkflowInstanceStep[] @relation("StepAssignee")
  stepsDecided  WorkflowInstanceStep[] @relation("StepDecider")

  @@index([department])
  @@index([role])
  @@index([lineManager])
  @@index([organizationId])
  @@index([managerId])
  @@index([departmentId])
  @@index([teamId])
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id           String   @id @default(uuid())
  departmentId String
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members    User[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Counterparty {
  id             String  @id @default(uuid())
  organizationId String?
  name           String
  contactName    String?
  contactDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contacts     CounterpartyContact[]
  declarations Declaration[] @relation("DeclarationCounterparty")

  @@index([organizationId])
  @@unique([name, organizationId])
}

model CounterpartyContact {
  id             String @id @default(uuid())
  counterpartyId String
  name           String
  details        String?

  createdAt DateTime @default(now())

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId])
}

model Declaration {
  id                  String   @id
  type                String
  value               Float
  status              String
  priority            String
  organizationId      String?

  // Canonical timestamps (UTC). Populated synchronously on every write from
  // the user-supplied calendar dates.
  eventDate   DateTime?
  submittedAt DateTime?

  declarerUserId       String?
  declarer             User? @relation("DeclarationDeclarer", fields: [declarerUserId], references: [id], onDelete: SetNull)

  currentApproverUserId String?
  currentApprover       User? @relation("DeclarationApprover", fields: [currentApproverUserId], references: [id], onDelete: SetNull)

  counterpartyId String?
  counterpartyRef Counterparty? @relation("DeclarationCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation("DeclarationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  snapshot  DeclarationSnapshot?
  detail    DeclarationDetail?
  fileLinks DeclarationFile[]
  workflow  WorkflowInstance? @relation("InstanceDeclaration")
  workflowSteps WorkflowInstanceStep[]

  @@index([status])
  @@index([organizationId])
  @@index([value])
  @@index([declarerUserId])
  @@index([currentApproverUserId])
  @@index([counterpartyId])
  @@index([eventDate])
  @@index([submittedAt])
}

// Immutable declaration-time context: preserves who/where the declarer was
// at submission so later team moves don't rewrite history.
model DeclarationSnapshot {
  id                String   @id @default(uuid())
  declarationId     String   @unique
  declarerName      String
  employeeNumber    String
  positionTitle     String
  department        String
  managerDisplayName String?
  capturedAt        DateTime @default(now())

  declaration Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
}

model DeclarationDetail {
  id                  String @id @default(uuid())
  declarationId       String @unique
  description         String
  occasion            String
  relationship        String
  receivedGiven       String
  fromField           String
  contactPerson       String
  biddingProcess      String
  contractNegotiation String?
  instances           String
  publicOfficial      String
  substantiation      String?

  declaration Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
}

// Explicit join between declarations and uploaded file metadata — the only
// file association. Orphan UploadedFile rows are rejected.
model DeclarationFile {
  id            String   @id @default(uuid())
  declarationId String
  fileId        String   @unique
  createdAt     DateTime @default(now())

  declaration Declaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  file        UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([declarationId])
}

model WorkflowRule {
  id        String   @id
  name      String
  condition String
  priority  Int
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ruleSteps  WorkflowRuleStep[]
  instances  WorkflowInstance[]

  @@index([organizationId])
}

model WorkflowRuleStep {
  id     String @id @default(uuid())
  ruleId String
  order  Int
  role   String
  label  String

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, order])
  @@index([ruleId])
}

model WorkflowInstance {
  declarationId String   @id
  ruleId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  declaration Declaration @relation("InstanceDeclaration", fields: [declarationId], references: [id], onDelete: Cascade)
  rule WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  stepRows  WorkflowInstanceStep[] @relation("InstanceSteps")

  @@index([ruleId])
}

model WorkflowInstanceStep {
  id            String   @id @default(uuid())
  instanceId    String
  declarationId String
  stepOrder     Int
  role          String
  label         String
  assigneeId    String?
  assigneeName  String
  status        String   @default("pending")
  decision      String?
  notes         String   @default("")
  decidedAt     DateTime?
  decidedById   String?
  decidedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instance    WorkflowInstance @relation("InstanceSteps", fields: [instanceId], references: [declarationId], onDelete: Cascade)
  declaration Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  assignee    User? @relation("StepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("StepDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([instanceId, stepOrder])
  @@index([declarationId])
  @@index([assigneeId])
  @@index([status])
  @@index([role])
}

model SystemConfig {
  id                      String @id
  highValueThreshold      Float
  mediumValueThreshold    Float
  slaEscalationDays       Int
  maxDeclarationsPerCounterparty Int
  maximumValue            Float   @default(1000000)
  emailTemplate           String
  notificationTemplates   String @default("{}")
}

model ApprovalOption {
  id    String @id
  value String
  label String
}

model UploadedFile {
  id            String   @id @default(cuid())
  originalName  String
  mimeType      String
  size          Int
  path          String
  uploadedAt    DateTime @default(now())

  link DeclarationFile?

  @@index([id])
}
