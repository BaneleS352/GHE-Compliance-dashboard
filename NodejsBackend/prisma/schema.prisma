generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL is the single authoritative provider for development, CI,
  // and production (see docs/DATABASE-NORMALIZATION-GOAL.md "Identifier
  // Strategy"). The SQLite dev workflow and the Dockerfile provider-rewrite
  // were removed with the numeric identifier cutover.
  //
  // Numeric identifier model (migration 0006_numeric_keys): every internal
  // primary and foreign key is native PostgreSQL BIGINT (identity columns),
  // except Declaration.id which remains the public GHE-YYYY-NNNNNN text
  // business reference (with an internal numeric declarationPk that all
  // normalized child tables reference). SystemConfig ("default") and
  // ApprovalOption ("opt-*"/"ao-*") keep text ids: they are singleton /
  // code-list rows outside the numeric-key scope.
  //
  // Retired in 0005 (no numeric migration needed): OrganizationSetting,
  // AppRole/UserRole, Ref* lookup copies, Dropdowns, ComplianceTrendPoint,
  // TypeBreakdownItem, Declaration legacy text/JSON columns,
  // WorkflowRule/WorkflowInstance steps JSON, UploadedFile.declarationId.
  //
  // The API response shape is unchanged apart from identifiers: numeric ids
  // are exposed as JSON numbers (see services/ids.ts). `declarationResponse`
  // in services/workflowService.ts builds the user-facing Declaration shape
  // from Snapshot/Detail/Counterparty/User joins.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  shortCode String   @unique
  users     User[]
  declarations Declaration[] @relation("DeclarationOrganization")
  departments Department[]
  counterparties Counterparty[]
  workflowRules WorkflowRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               BigInt   @id @default(autoincrement())
  name             String
  email            String   @unique
  passwordHash     String
  role             String
  teamMemberNumber String
  // departmentId -> Department is the sole department source of truth.
  // Display values derive from departmentRef; the legacy `department` text
  // column was removed in 0008_department_id_only.
  position         String
  // Display text only. The authoritative manager reference is managerId.
  lineManager      String?
  organizationId   BigInt?

  managerId    BigInt?
  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[] @relation("UserManager")

  departmentId BigInt?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  teamId BigInt?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  declarationsOwned Declaration[] @relation("DeclarationDeclarer")
  approvalsAssigned Declaration[] @relation("DeclarationApprover")
  stepsAssigned WorkflowInstanceStep[] @relation("StepAssignee")
  stepsDecided  WorkflowInstanceStep[] @relation("StepDecider")

  @@index([role])
  @@index([lineManager])
  @@index([organizationId])
  @@index([managerId])
  @@index([departmentId])
  @@index([teamId])
}

model Department {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt
  name           String
  code           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id           BigInt   @id @default(autoincrement())
  departmentId BigInt
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members    User[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Counterparty {
  id             BigInt  @id @default(autoincrement())
  organizationId BigInt?
  name           String
  contactName    String?
  contactDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contacts     CounterpartyContact[]
  declarations Declaration[] @relation("DeclarationCounterparty")

  @@index([organizationId])
  @@unique([name, organizationId])
}

model CounterpartyContact {
  id             BigInt @id @default(autoincrement())
  counterpartyId BigInt
  name           String
  details        String?

  createdAt DateTime @default(now())

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([counterpartyId])
}

model Declaration {
  // Public business reference (GHE-YYYY-NNNNNN). Never replaced by an
  // integer in the API, URLs, notifications, reports, or audit records.
  id                  String   @id
  // Internal numeric key. All normalized child tables reference this, never
  // the public text id.
  declarationPk       BigInt   @unique @default(autoincrement())
  type                String
  value               Float
  status              String
  priority            String
  organizationId      BigInt?

  // Canonical timestamps (UTC). Populated synchronously on every write from
  // the user-supplied calendar dates.
  eventDate   DateTime?
  submittedAt DateTime?

  declarerUserId       BigInt?
  declarer             User? @relation("DeclarationDeclarer", fields: [declarerUserId], references: [id], onDelete: SetNull)

  currentApproverUserId BigInt?
  currentApprover       User? @relation("DeclarationApprover", fields: [currentApproverUserId], references: [id], onDelete: SetNull)

  counterpartyId BigInt?
  counterpartyRef Counterparty? @relation("DeclarationCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation("DeclarationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  snapshot  DeclarationSnapshot?
  detail    DeclarationDetail?
  fileLinks DeclarationFile[]
  workflow  WorkflowInstance? @relation("InstanceDeclaration")
  workflowSteps WorkflowInstanceStep[]

  @@index([status])
  @@index([organizationId])
  @@index([value])
  @@index([declarerUserId])
  @@index([currentApproverUserId])
  @@index([counterpartyId])
  @@index([eventDate])
  @@index([submittedAt])
}

// Immutable declaration-time context: preserves who/where the declarer was
// at submission so later team moves don't rewrite history.
model DeclarationSnapshot {
  id                BigInt   @id @default(autoincrement())
  declarationPk     BigInt   @unique
  declarerName      String
  employeeNumber    String
  positionTitle     String
  department        String
  managerDisplayName String?
  capturedAt        DateTime @default(now())

  declaration Declaration @relation(fields: [declarationPk], references: [declarationPk], onDelete: Cascade)
}

model DeclarationDetail {
  id                  BigInt @id @default(autoincrement())
  declarationPk       BigInt @unique
  description         String
  occasion            String
  relationship        String
  receivedGiven       String
  fromField           String
  contactPerson       String
  biddingProcess      String
  contractNegotiation String?
  instances           String
  publicOfficial      String
  substantiation      String?

  declaration Declaration @relation(fields: [declarationPk], references: [declarationPk], onDelete: Cascade)
}

// Explicit join between declarations and uploaded file metadata — the only
// file association. Orphan UploadedFile rows are rejected.
model DeclarationFile {
  id            BigInt   @id @default(autoincrement())
  declarationPk BigInt
  fileId        BigInt   @unique
  createdAt     DateTime @default(now())

  declaration Declaration  @relation(fields: [declarationPk], references: [declarationPk], onDelete: Cascade)
  file        UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([declarationPk])
}

model WorkflowRule {
  id        BigInt   @id @default(autoincrement())
  name      String
  condition String
  priority  Int
  organizationId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ruleSteps  WorkflowRuleStep[]
  instances  WorkflowInstance[]

  @@index([organizationId])
}

model WorkflowRuleStep {
  id     BigInt @id @default(autoincrement())
  ruleId BigInt
  order  Int
  role   String
  label  String

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, order])
  @@index([ruleId])
}

model WorkflowInstance {
  id            BigInt   @id @default(autoincrement())
  declarationPk BigInt   @unique
  ruleId        BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  declaration Declaration @relation("InstanceDeclaration", fields: [declarationPk], references: [declarationPk], onDelete: Cascade)
  rule WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  stepRows  WorkflowInstanceStep[] @relation("InstanceSteps")

  @@index([ruleId])
  // Supports the composite step identity below: a step's (instanceId,
  // declarationPk) must identify the same declaration as its instance.
  @@unique([id, declarationPk])
}

model WorkflowInstanceStep {
  id            BigInt   @id @default(autoincrement())
  instanceId    BigInt
  declarationPk BigInt
  stepOrder     Int
  role          String
  label         String
  assigneeId    BigInt?
  assigneeName  String
  status        String   @default("pending")
  decision      String?
  notes         String   @default("")
  decidedAt     DateTime?
  decidedById   BigInt?
  decidedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Composite step identity: declarationPk duplicates the instance's key
  // for reporting joins, but the composite FK proves both values identify
  // the same declaration — a step row cannot point at two declarations.
  instance    WorkflowInstance @relation("InstanceSteps", fields: [instanceId, declarationPk], references: [id, declarationPk], onDelete: Cascade)
  declaration Declaration @relation(fields: [declarationPk], references: [declarationPk], onDelete: Cascade)
  assignee    User? @relation("StepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("StepDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([instanceId, stepOrder])
  @@index([declarationPk])
  @@index([assigneeId])
  @@index([status])
  @@index([role])
}

model SystemConfig {
  id                      String @id
  highValueThreshold      Float
  mediumValueThreshold    Float
  slaEscalationDays       Int
  maxDeclarationsPerCounterparty Int
  maximumValue            Float   @default(1000000)
  emailTemplate           String
  notificationTemplates   String @default("{}")
}

model ApprovalOption {
  id    String @id
  value String
  label String
}

model UploadedFile {
  id            BigInt   @id @default(autoincrement())
  originalName  String
  mimeType      String
  size          Int
  path          String
  uploadedAt    DateTime @default(now())

  // Required by policy, optional in Prisma: back-relations cannot enforce
  // presence at the database level. Unattached temporary uploads are not
  // supported — every file is created together with its DeclarationFile join
  // row in one transaction; orphan rows are rejected, admin-quarantined on
  // read, and cascade-removed with their declaration (see docs/SCHEMA.md,
  // pg:test "no orphan uploaded files").
  link DeclarationFile?
}
